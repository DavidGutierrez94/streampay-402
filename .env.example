# Names only. Put real values in GitHub secrets, never in this file.
# The deploy workflow syncs each name below when that secret is set.
# It does not print values, and it does not overwrite a wallet key already stored on Vercel.

PAYER_KEY=
PAYEE_KEY=
PAYEE_ADDRESS=
RPC_URL=
ESCROW_ADDRESS=
REGISTRY_ADDRESS=
PRIVY_APP_ID=
PUBLIC_URL=
DEMO_TOKEN=
RATE_PER_SEC=

# Redis REST URL and token. Set one pair. Either name works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

